# Указываете сложную строку, пример: bceccaf4416b674930d005e39fd313d9f7135f3de0292fb7e8d41f6be0b510ac
# Сгенерировать строку можно на сервисе https://jwtsecrets.com/#generator
JWT_SECRET=JWT_SECRET
DB_PATH=./data/cms.db
# Список администраторов. Название логина и сложного пароля с спец символами
# Пример: "admin1:pass1,admin2:pass2"
ADMIN_USERS="ЛОГИН1:ПАРОЛЬ1,ЛОГИН2:ПАРОЛЬ2"
SMTP_HOST="smtp.example.ru"
SMTP_PORT=465
SMTP_USER="example@example.ru"
SMTP_PASS="password"
SMTP_FROM="example@example.ru"
# Запасной email, если в админке не указаны получатели заявок
CONTACT_FALLBACK_EMAIL="example@example.ru"
# ПРИМЕР: rythm-group.com"
NEXT_PUBLIC_SITE_URL="ВАШ_ДОМЕН"

# Yandex Object Storage (S3-совместимое). Нужны для всех CMS-медиа (логотипы, аватары, фоны, блог).
# Статический ключ доступа сервисного аккаунта в Yandex Cloud.
YA_STORAGE_ID=
YA_STORAGE_SECRET=
YA_BUCKET_NAME=
YA_REGION=ru-central1
YA_ENDPOINT=https://storage.yandexcloud.net
# Обязателен для <img src> в браузере (= YA_ENDPOINT/YA_BUCKET_NAME, без / в конце).
# Без него клиент не соберёт public URL из S3-ключей.
NEXT_PUBLIC_YA_PUBLIC_BASE=https://storage.yandexcloud.net/ВАШ_БАКЕТ
